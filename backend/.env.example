DATABASE_URL=postgresql+psycopg://candy:candy@localhost:5432/cutencandy
CORS_ORIGINS=http://localhost:5173
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Set to true in production (HTTPS only cookies)
COOKIE_SECURE=false

# Razorpay: Dashboard (Test Mode) > Account & Settings > API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any long random string; enter the same value when adding the webhook in Razorpay
RAZORPAY_WEBHOOK_SECRET=

SITE_URL=http://localhost:5173
# Email (SMTP). Leave SMTP_HOST empty to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=QutnCandy <no-reply@qutncandy.com>

# Google sign-in: Google Cloud Console > Credentials > OAuth client ID (Web). Origin: your site URL.
GOOGLE_CLIENT_ID=
# Phone OTP login. No SMS provider yet, so codes are printed in the backend log (dev only).
OTP_ENABLED=false
