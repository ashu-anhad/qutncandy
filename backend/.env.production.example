# Production settings. ./deploy.sh creates backend/.env.production from this with fresh secrets.
# That file stays on your Mac and the server only (never commit it).
ENVIRONMENT=production
DOMAIN=qutncandy.com
SITE_URL=https://qutncandy.com
CORS_ORIGINS=https://qutncandy.com

# Generated: long random values
JWT_SECRET=
POSTGRES_PASSWORD=
COOKIE_SECURE=true

# Razorpay test keys (Dashboard > Test Mode > API Keys). Empty = "Pay" says online payment isn't set up.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email via Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=QutnCandy <no-reply@qutncandy.com>

GOOGLE_CLIENT_ID=
# No SMS provider yet, so keep phone login off in production.
OTP_ENABLED=false
